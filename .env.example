# Generate the three Nexus values with: openssl rand -hex 32
GITEA_WEBHOOK_SECRET=replace-with-a-random-secret
NEXUS_STATUS_TOKEN=replace-with-a-separate-random-secret
NEXUS_DEPLOY_TOKEN=replace-with-a-third-random-secret

# Create this in Gitea: Site Administration -> Actions -> Runners.
GITEA_RUNNER_REGISTRATION_TOKEN=replace-with-the-gitea-runner-token
